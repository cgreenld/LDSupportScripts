# DevCycle to LaunchDarkly Migration - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# DevCycle Credentials
# ============================================
# Get these from DevCycle Dashboard > Settings > API Credentials
DEVCYCLE_CLIENT_ID=your_client_id_here
DEVCYCLE_CLIENT_SECRET=your_client_secret_here

# The DevCycle project ID to migrate FROM
# Find this in your DevCycle project settings or URL
DEVCYCLE_PROJECT_ID=your_project_id_here

# ============================================
# LaunchDarkly Credentials
# ============================================
# Create an API access token at: Account Settings > Authorization > Access Tokens
# Required scopes: writer (for creating flags/segments)
LD_API_TOKEN=your_token_here

# The LaunchDarkly project key to migrate TO
# This is the URL-friendly key, not the display name
LD_PROJECT_KEY=your_project_key_here

# ============================================
# Migration Settings
# ============================================
# Set to 'false' to actually execute the migration
# When 'true', changes are logged but not applied
DRY_RUN=tru

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Optional: Map DevCycle environment keys to LaunchDarkly environment keys
# Format: dc_env1:ld_env1,dc_env2:ld_env2
# Example: dev:test,staging:staging,prod:production
ENVIRONMENT_MAP=
